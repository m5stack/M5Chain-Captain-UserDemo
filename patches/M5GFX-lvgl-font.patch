+  void LVGLFont::getDefaultMetric(FontMetrics* metrics) const
+  {
+    if (_font == nullptr)
+    {
+      metrics->width     = 0;
+      metrics->x_advance = 0;
+      metrics->x_offset  = 0;
+      metrics->height    = 0;
+      metrics->y_advance = 0;
+      metrics->y_offset  = 0;
+      metrics->baseline  = 0;
+      return;
+    }
+
+    metrics->height    = lv_font_get_line_height(_font);
+    metrics->y_advance = metrics->height;
+    metrics->baseline  = metrics->height - _font->base_line;
+    metrics->y_offset  = -metrics->baseline;
+    metrics->width     = (metrics->height * 5) >> 3;
+    metrics->x_advance = metrics->width;
+    metrics->x_offset  = 0;
+  }
+
+  bool LVGLFont::updateFontMetric(FontMetrics* metrics, uint16_t uniCode) const
+  {
+    return updateFontMetric(metrics, uniCode, 0);
+  }
+
+  bool LVGLFont::updateFontMetric(FontMetrics* metrics, uint16_t uniCode, uint16_t nextCode) const
+  {
+    if (_font == nullptr)
+    {
+      metrics->x_offset  = 0;
+      metrics->width     = 0;
+      metrics->x_advance = 0;
+      return false;
+    }
+
+    lv_font_glyph_dsc_t glyph{};
+    bool found = lv_font_get_glyph_dsc(_font, &glyph, uniCode, nextCode);
+    if (!found)
+    {
+      metrics->x_offset  = 0;
+      metrics->width     = 0;
+      metrics->x_advance = (metrics->height * 5) >> 3;
+      return false;
+    }
+
+    metrics->x_offset  = glyph.ofs_x;
+    metrics->width     = glyph.box_w;
+    metrics->x_advance = glyph.adv_w;
+    lv_font_glyph_release_draw_data(&glyph);
+    return true;
+  }
+
+  size_t LVGLFont::drawChar(LGFXBase* gfx, int32_t x, int32_t y, uint16_t uniCode, const TextStyle* style,
+                            FontMetrics* metrics, int32_t& filled_x) const
+  {
+    if (_font == nullptr)
+    {
+      return drawCharDummy(gfx, x, y, metrics->x_advance, metrics->height, style, filled_x);
+    }
+
+    int32_t sy = 65536 * style->size_y;
+    int32_t sx = 65536 * style->size_x;
+    y += (metrics->y_offset * sy) >> 16;
+
+    lv_font_glyph_dsc_t glyph{};
+    if (!lv_font_get_glyph_dsc(_font, &glyph, uniCode, 0))
+    {
+      return drawCharDummy(gfx, x, y, metrics->x_advance, metrics->height, style, filled_x);
+    }
+
+    uint8_t bits_per_pixel;
+    switch (glyph.format)
+    {
+    case LV_FONT_GLYPH_FORMAT_A1:
+      bits_per_pixel = 1;
+      break;
+    case LV_FONT_GLYPH_FORMAT_A2:
+      bits_per_pixel = 2;
+      break;
+    case LV_FONT_GLYPH_FORMAT_A3:
+      bits_per_pixel = 3;
+      break;
+    case LV_FONT_GLYPH_FORMAT_A4:
+      bits_per_pixel = 4;
+      break;
+    case LV_FONT_GLYPH_FORMAT_A8:
+      bits_per_pixel = 8;
+      break;
+    default:
+      lv_font_glyph_release_draw_data(&glyph);
+      return drawCharDummy(gfx, x, y, metrics->x_advance, metrics->height, style, filled_x);
