+
+void WifiConfigurationAp::BeginExitRequestSession()
+{
+    CancelExitRequests(false);
+
+    auto state = exit_request_state_;
+    if (!state) {
+        return;
+    }
+
+    std::lock_guard<std::mutex> lock(state->mutex);
+    ++state->generation;
+    state->active = true;
+}
+
+void WifiConfigurationAp::CancelExitRequests(bool wait_for_tasks)
+{
+    auto state = exit_request_state_;
+    if (!state) {
+        return;
+    }
+
+    const TaskHandle_t current_task = xTaskGetCurrentTaskHandle();
+    bool called_from_exit_task      = false;
+    {
+        std::lock_guard<std::mutex> lock(state->mutex);
+        state->active = false;
+        ++state->generation;
+        state->pending_generation = 0;
+
+        for (TaskHandle_t task : state->tasks) {
+            if (task == current_task) {
+                called_from_exit_task = true;
+            } else {
+                xTaskNotifyGive(task);
+            }
+        }
+    }
+
+    if (!wait_for_tasks || called_from_exit_task) {
+        return;
+    }
+
+    if (state->tasks_idle != nullptr) {
+        xEventGroupWaitBits(state->tasks_idle, EXIT_REQUEST_TASKS_IDLE_BIT, pdFALSE, pdTRUE, portMAX_DELAY);
+        return;
+    }
+
+    for (;;) {
+        {
+            std::lock_guard<std::mutex> lock(state->mutex);
+            if (state->tasks.empty()) {
+                return;
+            }
+        }
+        vTaskDelay(1);
+    }
+}
+
+void WifiConfigurationAp::ScheduleExitRequest(std::uint32_t delay_ms)
+{
+    auto state = exit_request_state_;
+    if (!state) {
+        return;
+    }
+
+    std::lock_guard<std::mutex> lock(state->mutex);
+    if (!state->active || state->pending_generation == state->generation) {
+        return;
+    }
+
+    auto *context = new (std::nothrow) ExitRequestTaskContext{state, state->generation, delay_ms};
+    if (context == nullptr) {
+        ESP_LOGE(TAG, "Failed to allocate exit request task context");
+        return;
+    }
+
+    if (state->tasks_idle != nullptr) {
+        xEventGroupClearBits(state->tasks_idle, EXIT_REQUEST_TASKS_IDLE_BIT);
+    }
+
+    TaskHandle_t task = nullptr;
+    BaseType_t result = xTaskCreate(ExitRequestTask, "exit_config_task", 4096, context, 5, &task);
+    if (result != pdPASS) {
+        ESP_LOGE(TAG, "Failed to create exit request task");
+        delete context;
+        if (state->tasks.empty() && state->tasks_idle != nullptr) {
+            xEventGroupSetBits(state->tasks_idle, EXIT_REQUEST_TASKS_IDLE_BIT);
+        }
+        return;
+    }
+
+    state->tasks.push_back(task);
+    state->pending_generation = state->generation;
+}
+
+void WifiConfigurationAp::ExitRequestTask(void *arg)
+{
+    auto *context                           = static_cast<ExitRequestTaskContext *>(arg);
+    std::shared_ptr<ExitRequestState> state = std::move(context->state);
+    const std::uint64_t generation          = context->generation;
+    const std::uint32_t delay_ms            = context->delay_ms;
+    delete context;
+
+    const bool cancelled = ulTaskNotifyTake(pdTRUE, pdMS_TO_TICKS(delay_ms)) != 0;
+    if (!cancelled) {
+        std::function<void()> callback;
+        {
+            std::lock_guard<std::mutex> lock(state->mutex);
+            if (state->active && state->generation == generation) {
+                state->active             = false;
+                state->pending_generation = 0;
+                callback                  = state->callback;
+            }
+        }
+        if (callback) {
+            callback();
+        }
+    }
+
+    const TaskHandle_t current_task = xTaskGetCurrentTaskHandle();
+    {
+        std::lock_guard<std::mutex> lock(state->mutex);
+        auto task = std::find(state->tasks.begin(), state->tasks.end(), current_task);
+        if (task != state->tasks.end()) {
+            state->tasks.erase(task);
+        }
+        if (state->tasks.empty() && state->tasks_idle != nullptr) {
+            xEventGroupSetBits(state->tasks_idle, EXIT_REQUEST_TASKS_IDLE_BIT);
+        }
+    }
+
+    state.reset();
+    vTaskDelete(nullptr);
 }
 
